# Public application configuration. Server-only values follow below.
NEXT_PUBLIC_ORRYLO_DATA_MODE=demo
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Leave empty until reviewed deployment evidence provides a real public contract ID.
NEXT_PUBLIC_FOUNDATION_CONTRACT_ID=

# Server-only wallet-authentication context.
# Set this to the exact hostname users are actually visiting.
# Canonical target: orrylo.com. Temporary Railway deployments must use their
# current Railway hostname until the custom domain is live.
ORRYLO_AUTH_DOMAIN=localhost

# Server-only PostgreSQL connections. Replace placeholders locally/deployment-side.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB_NAME

# Testnet MVP activation inputs. Never put a Stellar secret seed here.
# Must be the owner-approved NEW random Testnet Shared Issuer public key.
ORRYLO_APPROVED_TESTNET_SHARED_ISSUER_PUBLIC_KEY=
# Positive stroop fee; the read-only verifier rejects a value below the stable
# official Testnet ledger base fee.
ORRYLO_TESTNET_SHARED_ISSUER_FEE_STROOPS=
# Dedicated LOGIN credential that is a member of the NOLOGIN
# orrylo_confirmation_writer role and is not the application/schema owner.
ORRYLO_CONFIRMATION_WRITER_DATABASE_URL=
# Web application -> private Railway signer service. Must be an internal
# http://<service>.railway.internal:<port> URL; no public signer URL is accepted.
ORRYLO_TESTNET_SIGNER_PRIVATE_URL=
# Runtime service-auth token shared only by the web application and signer
# service. Use a strong secret at deployment time; never commit a real value.
ORRYLO_TESTNET_SIGNER_REQUEST_AUTH_SECRET=

# The Stellar signer seed is intentionally absent from this web application
# example. It belongs only to the isolated signer service runtime.

# Separate schema-owner credential used only by migration and schema verification commands.
MIGRATION_DATABASE_URL=postgres://MIGRATION_OWNER:PASSWORD@localhost:5432/DB_NAME
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB_NAME_TEST

# Server-only fixed official launch time for the 60-day first-token reward.
# Leave unset until the official launch timestamp is approved.
# ORRYLO_OFFICIAL_LAUNCH_AT=YYYY-MM-DDTHH:mm:ss.sssZ
ORRYLO_OFFICIAL_LAUNCH_AT=

# Owner-approved Testnet customer ChangeTrust transaction fee ceiling (stroops).
# Required for self-service trustline preparation. No default; configure before activation.
ORRYLO_TESTNET_CUSTOMER_TRUSTLINE_MAX_FEE_STROOPS=
