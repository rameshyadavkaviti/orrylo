# Public, non-secret application configuration only.
NEXT_PUBLIC_ORRYLO_DATA_MODE=demo
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Leave empty until reviewed deployment evidence provides a real public contract ID.
NEXT_PUBLIC_FOUNDATION_CONTRACT_ID=

# Server-only wallet-authentication context. Use app.orrylo.com in production.
ORRYLO_AUTH_DOMAIN=localhost

# Server-only PostgreSQL connections. Replace placeholders locally/deployment-side.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB_NAME
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB_NAME_TEST

# Server-only fixed official launch time for the 60-day first-token reward.
# Intentionally blank until the official timestamp is approved.
ORRYLO_OFFICIAL_LAUNCH_AT=
