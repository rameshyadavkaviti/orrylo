{
  "name": "@orrylo/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "signer:build": "tsc -p signer-service/tsconfig.json",
    "signer:start": "node .signer-dist/signer-service/server.js",
    "signer:mainnet:start": "node .signer-dist/signer-service/mainnet-server.js",
    "signer:mainnet:verify-connectivity": "node scripts/verify-mainnet-signer-connectivity.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:verify:read-only": "tsx scripts/verify-schema-read-only.ts",
    "activation:verify:testnet": "tsx scripts/verify-testnet-activation.ts",
    "issuance:manual:testnet": "tsx scripts/manual-testnet-shared-issuance.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts"
  },
  "dependencies": {
    "@albedo-link/intent": "0.13.0",
    "@stellar/stellar-sdk": "17.2.1",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
